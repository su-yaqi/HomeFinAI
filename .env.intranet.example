# HomeFin 内网部署环境变量模板
# 部署时建议复制为 `.env`，然后把下面的示例值替换成你的真实配置。

# 内网访问配置
# 把下面的占位符替换成部署服务器在内网中的实际访问地址。
DOMAIN=<frontend-host>
FRONTEND_HOST=http://<frontend-host>:8080
INTRANET_API_URL=http://<api-host>:8000

# 运行环境，可选：local / staging / production
ENVIRONMENT=production

# 项目名称，会显示在系统界面和邮件标题等位置
PROJECT_NAME="HomeFin"
# Docker Compose 栈名称，建议内网环境单独命名，避免与其他环境冲突
STACK_NAME=homefin-intranet

# 后端配置
# 允许访问后端 API 的前端来源地址，内网部署通常填前端访问地址即可
BACKEND_CORS_ORIGINS="http://<frontend-host>:8080"
# 用于签发登录令牌和安全校验，务必替换成高强度随机字符串
SECRET_KEY=replace-with-a-long-random-secret-key
# 系统初始化超级管理员账号
FIRST_SUPERUSER=admin@example.com
# 系统初始化超级管理员密码，务必替换
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# 邮件配置
# 如果内网环境暂时不需要“找回密码/发送邮件”能力，可以全部留空。
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
# 常见情况保持默认即可，除非你的 SMTP 服务要求特殊配置
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# PostgreSQL 配置
# 这里保留 localhost 即可，因为容器启动后 Compose 会把应用容器里的数据库地址覆盖成 `db`。
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
# 数据库密码，务必替换成高强度密码
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 可选监控配置
# 如果你暂时不接入 Sentry，可以留空。
SENTRY_DSN=

# Docker 镜像名
# 当前方案默认使用本地构建镜像，通常保持默认即可。
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# 前端构建时写入的后端 API 地址
# 前端镜像会在 build 阶段把这个地址写进去。
# 如果访问地址变化，需要更新这里并重新执行 `docker compose build`。
