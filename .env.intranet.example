# HomeFin 内网部署环境变量模板
# 部署时建议复制为 `.env`，然后把下面的示例值替换成你的真实配置。

# 内网访问配置。发布脚本仅接受 HTTP 地址，保持受控内网边界。
FRONTEND_HOST=http://<frontend-host>:8080
FRONTEND_URL=http://<frontend-host>:8080
BACKEND_URL=http://<api-host>:8000

# 运行环境，可选：local / staging / production
ENVIRONMENT=production

# 项目名称，会显示在系统界面和邮件标题等位置
PROJECT_NAME="HomeFin"
# Docker Compose 栈名称，建议内网环境单独命名，避免与其他环境冲突
STACK_NAME=homefin-intranet
# 发布前数据库备份与已部署镜像状态必须写入受控的绝对宿主机目录。
# 备份目录应另外同步到 NAS 或另一台内网机器。
HOMEFIN_BACKUP_DIR=/srv/homefin/backups
HOMEFIN_DEPLOY_STATE_DIR=/srv/homefin/deploy-state

# 后端配置
# 允许访问后端 API 的前端来源地址，内网部署通常填前端访问地址即可
BACKEND_CORS_ORIGINS="http://<frontend-host>:8080"
# 用于签发登录令牌和安全校验，务必替换成高强度随机字符串
SECRET_KEY=replace-with-a-long-random-secret-key
# 系统初始化超级管理员账号
FIRST_SUPERUSER=admin@example.com
# 系统初始化超级管理员密码，务必替换
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password

# 邮件配置
# 如果内网环境暂时不需要“找回密码/发送邮件”能力，可以全部留空。
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
# 常见情况保持默认即可，除非你的 SMTP 服务要求特殊配置
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# PostgreSQL 配置
# 这里保留 localhost 即可，因为容器启动后 Compose 会把应用容器里的数据库地址覆盖成 `db`。
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
# 数据库密码，务必替换成高强度密码
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# 可选监控配置
# 如果你暂时不接入 Sentry，可以留空。
SENTRY_DSN=

# 数据导入导出安全边界、并发数与文件保留期限
DATA_JOB_MAX_UPLOAD_BYTES=26214400
DATA_JOB_MAX_UNCOMPRESSED_BYTES=104857600
DATA_JOB_MAX_ARCHIVE_FILES=100
DATA_JOB_MAX_ACTIVE_JOBS=2
DATA_JOB_RETENTION_DAYS=30
DATA_JOB_STALE_MINUTES=60
# 财务看板用于判断“今天/本月”的 IANA 时区
BUSINESS_TIMEZONE=Asia/Shanghai

# 以下三项由发布工作流注入，不应手工改成 latest 或其他可变 tag。
# DEPLOY_SHA=<40-character-main-commit-sha>
# HOMEFIN_BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend@sha256:<digest>
# HOMEFIN_FRONTEND_IMAGE=ghcr.io/<owner>/<repo>/frontend@sha256:<digest>
