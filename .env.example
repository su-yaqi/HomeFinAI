# Local development environment template
#
# Copy this file to `.env` and fill in your own values before running locally.

DOMAIN=<frontend-host>
FRONTEND_HOST=http://<frontend-host>:<frontend-port>
INTRANET_API_URL=http://<api-host>:<api-port>

ENVIRONMENT=local

PROJECT_NAME="HomeFin"
STACK_NAME=homefin-local

BACKEND_CORS_ORIGINS="http://<frontend-host>:<frontend-port>"
SECRET_KEY=replace-with-a-long-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password

SENTRY_DSN=

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
