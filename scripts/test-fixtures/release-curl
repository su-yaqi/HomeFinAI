#!/usr/bin/env bash

set -Eeuo pipefail

count=0
if [[ -f "${MOCK_CURL_COUNT_FILE:?}" ]]; then
  count="$(<"${MOCK_CURL_COUNT_FILE}")"
fi
count=$((count + 1))
printf '%s\n' "${count}" >"${MOCK_CURL_COUNT_FILE}"

if [[ "${MOCK_DEPLOY_MODE:-success}" == "rollback" && "${count}" -eq 1 ]]; then
  exit 22
fi
